#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include "socket_utils.h"
#include "crypto.h"

static int server_fd; // РЎРѕРєРµС‚ СЃРѕРµРґРёРЅРµРЅРёСЏ СЃ СЃРµСЂРІРµСЂРѕРј
static char last_sender[32] = ""; // РџРѕСЃР»РµРґРЅРёР№ РѕС‚РїСЂР°РІРёС‚РµР»СЊ РґР»СЏ /reply
static char last_message[1024] = ""; // РџРѕСЃР»РµРґРЅРµРµ СЃРѕРѕР±С‰РµРЅРёРµ РґР»СЏ /forward

// РџРѕС‚РѕРє РїСЂРёС‘РјР° СЃРѕРѕР±С‰РµРЅРёР№ РѕС‚ СЃРµСЂРІРµСЂР°
void* receiver_thread(void* arg) {
    (void)arg;
    char buffer[4096];
    int in_history = 0;

   //С†РёРєР» РґР»СЏ РІС…РѕРґР° 
    while (1) {
        // РџСЂРёРЅРёРјР°РµРј РґР°РЅРЅС‹Рµ РѕС‚ СЃРµСЂРІРµСЂР° С‡РµСЂРµР· СЃРѕРєРµС‚ server_fd вЂ” С„Р°Р№Р»РѕРІС‹Р№ РґРµСЃРєСЂРёРїС‚РѕСЂ СЃРѕРєРµС‚Р° (РЅРѕРјРµСЂ СЃРѕРµРґРёРЅРµРЅРёСЏ) buffer вЂ” РјР°СЃСЃРёРІ, РєСѓРґР° Р±СѓРґСѓС‚ Р·Р°РїРёСЃР°РЅС‹ РїСЂРёРЅСЏС‚С‹Рµ Р±Р°Р№С‚С‹
        // sizeof(buffer) вЂ” РјР°РєСЃРёРјР°Р»СЊРЅС‹Р№ СЂР°Р·РјРµСЂ Р±СѓС„РµСЂР° (4096 Р±Р°Р№С‚) received вЂ” РєРѕР»РёС‡РµСЃС‚РІРѕ СЂРµР°Р»СЊРЅРѕ РїСЂРёРЅСЏС‚С‹С… Р±Р°Р№С‚
        //   > 0  вЂ” СѓСЃРїРµС€РЅРѕ РїСЂРёРЅСЏС‚Рѕ Р±Р°Р№С‚  = 0  вЂ” СЃРµСЂРІРµСЂ Р·Р°РєСЂС‹Р» СЃРѕРµРґРёРЅРµРЅРёРµ  < 0  вЂ” РѕС€РёР±РєР° РїСЂРёС‘РјР°
        int received = receive_message(server_fd, buffer, sizeof(buffer));
        if (received <= 0) {
            printf("\n[CLIENT] Server disconnected\n");
            exit(0);
        }
        // Р”РѕР±Р°РІР»СЏРµРј СЃРёРјРІРѕР» РєРѕРЅС†Р° СЃС‚СЂРѕРєРё '\0' РІ РєРѕРЅРµС† РїСЂРёРЅСЏС‚С‹С… РґР°РЅРЅС‹С…, buffer РјРѕР¶РЅРѕ РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РєР°Рє РѕР±С‹С‡РЅСѓСЋ C-СЃС‚СЂРѕРєСѓ (printf, strtok Рё С‚.Рґ.)
        buffer[received] = '\0';

        char* line = strtok(buffer, "\n");
        // РџРµСЂРµР±РёСЂР°РµРј РІСЃРµ СЃС‚СЂРѕРєРё, РїРѕР»СѓС‡РµРЅРЅС‹Рµ РѕС‚ СЃРµСЂРІРµСЂР°
        while (line) {
            if (strlen(line) == 0) { line = strtok(NULL, "\n"); continue; } // РџСЂРѕРїСѓСЃРєР°РµРј РїСѓСЃС‚С‹Рµ СЃС‚СЂРѕРєРё

            // РџСЂРѕРІРµСЂСЏРµРј, Р·Р°С€РёС„СЂРѕРІР°РЅРѕ Р»Рё СЃРѕРѕР±С‰РµРЅРёРµ (РїСЂРµС„РёРєСЃ "ENC:")
            if (strncmp(line, "ENC:", 4) == 0) {
                // Р Р°СЃС€РёС„СЂРѕРІС‹РІР°РµРј РґР°РЅРЅС‹Рµ РїРѕСЃР»Рµ "ENC:" (hex -> С‚РµРєСЃС‚)
                char* decrypted = crypto_decrypt(line + 4);
                if (decrypted) {
                    char* from_pos = strstr(decrypted, "[");  // Р