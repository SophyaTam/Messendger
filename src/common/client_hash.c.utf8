#include "client_hash.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static ClientNode* hash_table[HASH_SIZE];  // РҐРµС€-С‚Р°Р±Р»РёС†Р°: РјР°СЃСЃРёРІ СѓРєР°Р·Р°С‚РµР»РµР№ РЅР° РіРѕР»РѕРІС‹ СЃРІСЏР·РЅС‹С… СЃРїРёСЃРєРѕРІ

// РҐРµС€-С„СѓРЅРєС†РёСЏ djb2 вЂ” СЂР°РІРЅРѕРјРµСЂРЅРѕ СЂР°СЃРїСЂРµРґРµР»СЏРµС‚ СЃС‚СЂРѕРєРё РїРѕ 256 РєРѕСЂР·РёРЅР°Рј РІРѕР·РІСЂР°С‰Р°РµС‚ РёРЅРґРµРєСЃ РѕС‚ 0 РґРѕ HASH_SIZE-1
static unsigned int hash_func(const char* str) {
    unsigned int h = 5381;
    if (!str || !*str) return 0;  // РџСѓСЃС‚Р°СЏ СЃС‚СЂРѕРєР° в†’ РєРѕСЂР·РёРЅР° 0
    while (*str) h = ((h << 5) + h) + *str++;   // h = h * 33 + СЃРёРјРІРѕР»
    return h % HASH_SIZE;   // РћСЃС‚Р°С‚РѕРє РѕС‚ РґРµР»РµРЅРёСЏ РЅР° СЂР°Р·РјРµСЂ С‚Р°Р±Р»РёС†С‹
}

